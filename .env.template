# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_guild_id_here

# Database Configuration (Docker internal networking)
DATABASE_URL=postgresql://ticketbot:ticketbot_dev@postgres:5432/ticketbot

# Redis Configuration (Docker internal networking)
REDIS_URL=redis://redis:6379

# Backend Configuration
BACKEND_URL=http://backend:8000
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production_12345
API_KEY=dev_api_key_change_in_production_67890

# Development Configuration
DEBUG=true
LOG_LEVEL=INFO
ENVIRONMENT=development

# Web Dashboard Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000/ws

# Local Development Database (for direct connections)
LOCAL_DATABASE_URL=postgresql://ticketbot:ticketbot_dev@localhost:5432/ticketbot
